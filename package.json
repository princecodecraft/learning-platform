{
  "name": "learning-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @learning-platform/web run dev",
    "dev:dashboard": "npm --workspace @learning-platform/dashboard run dev",
    "dev:api": "npm --workspace @learning-platform/api run start:dev",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}